# Copy to .env and adjust if needed. All values are optional.

# Dashboard address. Keep HOST=127.0.0.1 so the app is only reachable from this computer.
PORT=3000
HOST=127.0.0.1

# Where the service account .json files live, and where the SQLite database is stored.
KEYS_DIR=./keys
DB_PATH=./data/smart-indexer.db

# DRY_RUN=1 simulates Google responses (no quota is used, nothing is sent to Google).
# Bridge registration with the Cloudflare Worker still happens for real.
DRY_RUN=0
